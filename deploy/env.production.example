# Modèle du fichier .env de PRODUCTION, à créer sur le VPS dans
# /var/www/kine-maxillo/.env (jamais commité). Générer chaque secret, ne
# réutiliser aucune valeur de dev.

# Base de données (conteneur dédié, non exposé)
POSTGRES_USER=kine
# openssl rand -hex 24  (hexadécimal : pas de caractère à échapper dans l'URL)
POSTGRES_PASSWORD=
POSTGRES_DB=kine_maxillo

# Auth praticienne
NEXTAUTH_URL="https://kine-maxillo-lyon.com"
# openssl rand -base64 32
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# Hash bcrypt du mot de passe (voir .env.example). Ici aussi, échapper
# chaque `$` : docker compose interprète `$` dans ce fichier.
ADMIN_PASSWORD_HASH=

# Emails (Brevo)
BREVO_API_KEY=
EMAIL_FROM="rendezvous@kine-maxillo-lyon.com"
EMAIL_FROM_NAME="Johanna Rouzier — Kinésithérapeute"
EMAIL_REPLY_TO="contact@kine-maxillo-lyon.com"
PRACTITIONER_NOTIFICATION_EMAIL="kinemaxillo.lyon@gmail.com"
SITE_URL="https://kine-maxillo-lyon.com"
