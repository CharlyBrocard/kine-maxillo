# Valeurs de développement local — à changer pour tout environnement
# partagé ou exposé (voir docker-compose.yml). Non secrets : la base
# n'est accessible qu'en localhost (voir docker-compose.yml).
POSTGRES_USER=kine
POSTGRES_PASSWORD=kine
POSTGRES_DB=kine_maxillo

DATABASE_URL="postgresql://kine:kine@localhost:5432/kine_maxillo?schema=public"

# Auth — mono-compte praticienne (voir src/lib/auth.ts). À générer
# toi-même, y compris en dev : ce sont de vrais secrets, contrairement
# aux identifiants Postgres ci-dessus.
NEXTAUTH_URL="http://localhost:3000"
# openssl rand -base64 32
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# node -e "require('bcryptjs').hash('<mot de passe>', 10).then(console.log)"
# IMPORTANT : échapper chaque `$` du hash bcrypt en `\$` dans .env, sinon
# Next.js (expansion de variables) ET docker compose les interprètent
# comme des références de variables et tronquent la valeur — vérifié en
# pratique, pas juste une précaution théorique.
ADMIN_PASSWORD_HASH=

# Emails transactionnels (Brevo) — voir src/lib/email/send.ts. Sans
# BREVO_API_KEY hors production, les emails sont affichés dans la console
# au lieu d'être envoyés. En production, BREVO_API_KEY et EMAIL_FROM sont
# obligatoires.
BREVO_API_KEY=
# Adresse d'un domaine authentifié dans Brevo (DKIM/SPF/DMARC) — jamais
# une adresse @gmail.com (rejetée ou classée en spam, politique DMARC).
EMAIL_FROM="rendezvous@kine-maxillo-lyon.com"
EMAIL_FROM_NAME="Johanna Rouzier — Kinésithérapeute"
# Adresse où arrivent les réponses des patients.
EMAIL_REPLY_TO=
# Destinataire des notifications (RDV confirmé, annulation patient). Vide =
# pas de notification.
PRACTITIONER_NOTIFICATION_EMAIL=
# URL publique du site, utilisée dans les liens des emails (défaut :
# NEXTAUTH_URL).
SITE_URL="http://localhost:3000"
