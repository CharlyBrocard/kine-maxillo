# Base de test dédiée (même Postgres local que le dev, DB séparée) — pour
# que `npm test` ne touche jamais aux données de dev/démo manipulées à la
# main pendant que tu testes l'app dans le navigateur.
DATABASE_URL="postgresql://kine:kine@localhost:5432/kine_maxillo_test?schema=public"

# Jamais de vraie clé Brevo en test (voir aussi le garde-fou dans
# src/lib/email/send.ts) : vide ici pour ne pas hériter de celle du .env.
BREVO_API_KEY=
PRACTITIONER_NOTIFICATION_EMAIL=
